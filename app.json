{
  "expo": {
    "name": "sportfolio",
    "slug": "sportfolio",
    "version": "1.0.0",
    "scheme": "sportfolio",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sportfolio uses the microphone for hands-free voice scoring and navigation.",
        "NSSpeechRecognitionUsageDescription": "Sportfolio uses speech recognition to let you score and navigate by voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
