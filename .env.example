# Copy to .env and fill in from your Supabase project (Settings → API).
# These are PUBLIC client keys; the anon key is safe to ship in the app.
# Until set, the app runs in demo mode against local sample data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Firebase (web SMS phone verification — see docs/firebase-phone-setup.md).
# Public web config from Firebase console → Project settings → Your apps → Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR-PROJECT.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR-PROJECT
EXPO_PUBLIC_FIREBASE_APP_ID=
