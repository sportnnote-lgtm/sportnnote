{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sportfolio-web-demo",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "port": 8091
    },
    {
      "name": "sportfolio-offline-demo",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "exec env EXPO_NO_DOTENV=1 npx expo start --web --port 8093"
      ],
      "port": 8093
    },
    {
      "name": "website",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "http-server@14.1.1",
        "website/dist",
        "-p",
        "8095",
        "-c-1",
        "-s"
      ],
      "port": 8095
    }
  ]
}
